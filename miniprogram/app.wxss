page {
  background: #f6f1ea;
  color: #2b2320;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(90, 60, 40, 0.06);
}

.card-t {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-t .more {
  font-size: 24rpx;
  font-weight: 400;
  color: #9a8b7f;
}

.muted {
  color: #8a7a6d;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f3ece4;
  color: #6b5344;
}

.btn.primary {
  background: linear-gradient(135deg, #c9541f, #b5451a);
  color: #fff;
}

.btn.ghost {
  background: #fff;
  border: 2rpx solid #f0b58c;
  color: #b5451a;
}

.btn.small {
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 26rpx;
  display: inline-flex;
}

.btn.disabled {
  background: #eee7df;
  color: #b6a89b;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #fdf1e7;
  color: #b5451a;
}

.tag.gray {
  background: #f2ede8;
  color: #8a7a6d;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #a5978a;
  font-size: 26rpx;
}

.err {
  color: #c0392b;
  font-size: 24rpx;
  padding: 8rpx 0;
}

.divider {
  height: 2rpx;
  background: #f2ece6;
  margin: 20rpx 0;
}

/* 列表条目 */
.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f6f1ea;
}

.item:last-child {
  border-bottom: none;
}

.item .ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #fdf1e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item .bd {
  flex: 1;
  min-width: 0;
}

.item .nm {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item .sub {
  font-size: 23rpx;
  color: #9a8b7f;
  margin-top: 6rpx;
}

.pts {
  color: #b5451a;
  font-weight: 700;
  font-size: 30rpx;
}

.pts.plus {
  color: #c0392b;
}

.pts.minus {
  color: #2f855a;
}
